# Linux: run ira-memory as a systemd user service.
#
#   1. Replace /PATH/TO/ira-memory below.
#   2. mkdir -p ~/.config/systemd/user && cp deploy/systemd/ira-memory.service ~/.config/systemd/user/
#   3. systemctl --user daemon-reload && systemctl --user enable --now ira-memory
#   4. Optional, to start at boot without logging in: sudo loginctl enable-linger $USER
# Logs: journalctl --user -u ira-memory -f
# Your user must be able to run docker (member of the docker group).

[Unit]
Description=ira-memory API server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/PATH/TO/ira-memory
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash /PATH/TO/ira-memory/scripts/start.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
