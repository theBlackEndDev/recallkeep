<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS: start recallkeep at login and restart it if it crashes.

  1. Replace every /PATH/TO/recallkeep and /Users/YOU below.
  2. cp deploy/launchd/dev.recallkeep.plist ~/Library/LaunchAgents/
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.recallkeep.plist
  Logs: ~/Library/Logs/recallkeep.{out,err}.log
  Stop: launchctl bootout gui/$(id -u)/dev.recallkeep
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.recallkeep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/PATH/TO/recallkeep/scripts/start.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/PATH/TO/recallkeep</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a minimal PATH: include bun and docker. -->
    <key>PATH</key>
    <string>/Users/YOU/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/recallkeep.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/recallkeep.err.log</string>
</dict>
</plist>
