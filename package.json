{
  "name": "recallkeep",
  "version": "0.1.0",
  "private": true,
  "description": "Long-term memory for AI coding agents: Postgres + pgvector, an HTTP API, an MCP server, and capture hooks for pi, Claude Code, Codex CLI and Antigravity CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theBlackEndDev/recallkeep.git"
  },
  "homepage": "https://github.com/theBlackEndDev/recallkeep#readme",
  "bugs": {
    "url": "https://github.com/theBlackEndDev/recallkeep/issues"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "memory-api": "bun run src/http-server.ts",
    "update": "bun run scripts/update.ts",
    "db:migrate": "bunx prisma migrate dev",
    "db:push": "bunx prisma db push",
    "db:generate": "bunx prisma generate",
    "db:studio": "bunx prisma studio",
    "redact-rescan": "bun run src/redact-rescan.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1",
    "@prisma/client": "^6.7.0",
    "openai": "^6.33.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "prisma": "^6.7.0",
    "typescript": "^5.7.0"
  }
}
