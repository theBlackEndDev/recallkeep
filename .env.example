# ira-memory configuration. Copy to .env and edit. Bun loads .env automatically.
# Only MEMORY_DATABASE_URL is required. Everything else has a working default.

# ─── Database (required) ────────────────────────────────────────
# Matches docker-compose.yml. Change the password with IRA_DB_PASSWORD before the
# first `docker compose up` if you want something other than the default.
MEMORY_DATABASE_URL="postgresql://ira_memory:ira_memory_secret@localhost:5433/ira_memory"
# IRA_DB_PORT="5433"            # host port docker-compose publishes (loopback only)
# IRA_DB_PASSWORD="..."         # docker-compose POSTGRES_PASSWORD; keep in sync with the URL above

# ─── LLM provider (embeddings + summaries) ──────────────────────
# IRA_LLM_PROVIDER picks where embeddings and summaries are computed:
#   openai (default) OpenAI cloud. Set OPENAI_API_KEY.
#   gemini           Google Gemini through its OpenAI-compatible endpoint. Set GEMINI_API_KEY.
#   local            Any OpenAI-compatible local server (Ollama, LM Studio). No key needed.
#                    Defaults: http://localhost:11434/v1, nomic-embed-text, llama3.2.
#   none             No external calls. No embeddings or summaries. Recall uses
#                    full-text search and project tags. Nothing leaves the machine.
# IRA_LLM_PROVIDER="none"

# OPENAI_API_KEY="sk-..."       # provider=openai
# GEMINI_API_KEY="..."          # provider=gemini
# OPENAI_BASE_URL="http://localhost:11434/v1"   # custom endpoint for local or gemini
# IRA_LLM_BASE_URL="http://localhost:11434/v1"  # same as above, provider=local only
# IRA_LLM_MODEL="gpt-4.1-nano"                  # chat model for summaries and learning
# IRA_EMBED_MODEL="text-embedding-3-small"      # embedding model
# IRA_EMBED_DIMS="1536"         # must match the vector(1536) schema; only change on a fresh DB
# IRA_EMBED="off"               # turn embeddings off but keep summaries

# ─── HTTP API server ────────────────────────────────────────────
# MEMORY_API_PORT="7775"
# MEMORY_API_HOST="127.0.0.1"   # anything other than loopback requires IRA_API_TOKEN
# IRA_API_TOKEN="..."           # when set, clients send `Authorization: Bearer <token>`
# IRA_CORS_ORIGINS=""           # comma-separated browser origins allowed to call the API (default none)
# IRA_URL="http://127.0.0.1:7775"  # where the MCP server, hooks and pi extension find the API
# IRA_CLIENT_TIMEOUT_MS="2000"  # MCP server and hook request timeout
# IRA_CWD="..."                 # MCP server: project directory, if the client starts it elsewhere
# IRA_HOOK_DEBUG="1"            # hooks print errors to stderr instead of failing silently

# ─── Storage paths ──────────────────────────────────────────────
# IRA_DATA_DIR="~/.ira-memory"  # local state (entity and key-value sidecar db)
# IRA_SIDECAR_DB="..."          # explicit sidecar path; ~/.claude/memory-api-sidecar.db is kept if it exists
# IRA_BACKUP_DIR="./backups"    # where `backup` writes dumps
# IRA_DB_CONTAINER="..."        # container for backup/restore; default is this repo's compose service

# ─── pi session capture ─────────────────────────────────────────
# /session/sync only reads files under pi's sessions dir. Follows pi's own
# PI_CODING_AGENT_SESSION_DIR and PI_CODING_AGENT_DIR. Override here if needed.
# IRA_PI_SESSIONS_DIR="~/.pi/agent/sessions"
# IRA_PI_MESSAGE_CAP="50000"    # max chars stored per message
# IRA_PI_TOOLRESULT_CAP="2000"  # max chars stored per tool result

# ─── Recall tuning (defaults are tested; change with care) ──────
# IRA_SEMANTIC_RECALL="1"       # 0 = full-text only
# IRA_FTS_CEILING="0.55"
# IRA_W_RELEVANCE="0.6"
# IRA_W_RECENCY="0.15"
# IRA_W_TIER="0.15"
# IRA_W_CONFIDENCE="0.1"
# IRA_CHUNK_CHARS="6000"        # embedding chunk size
# IRA_CHUNK_OVERLAP="400"
# IRA_AUTO_LEARN="true"         # "false" stops learning extraction on store
# IRA_DECISIONS_CONVO_CAP="60000"

# ─── Tooling ────────────────────────────────────────────────────
# IRA_BUN_PATH="/opt/bun/bin/bun"   # absolute bun path for hooks if bun is not on PATH
# IRA_PROJECT_DIR / IRA_LOG_DIR     # scripts/cron-maintain.sh overrides
# IRA_SERVICE_NAME="dev.ira-memory" # launchd label or systemd unit `bun run update` restarts
# IRA_TEST_DATABASE_URL="postgresql://.../ira_memory_test"  # enables DB tests in `bun test`
