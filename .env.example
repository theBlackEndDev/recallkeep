# recallkeep configuration. Copy to .env and edit. Bun loads .env automatically.
# Only RECALLKEEP_DATABASE_URL is required. Everything else has a working default.

# ─── Database (required) ────────────────────────────────────────
# Matches docker-compose.yml. Change the password with RECALLKEEP_DB_PASSWORD before the
# first `docker compose up` if you want something other than the default.
RECALLKEEP_DATABASE_URL="postgresql://recallkeep:recallkeep_secret@localhost:5433/recallkeep"
# RECALLKEEP_DB_PORT="5433"            # host port docker-compose publishes (loopback only)
# RECALLKEEP_DB_PASSWORD="..."         # docker-compose POSTGRES_PASSWORD; keep in sync with the URL above
# Your own Postgres, no Docker: point the URL at it (README, "Without Docker"). Docker is used only when
# the URL is this machine on RECALLKEEP_DB_PORT. Override that guess with:
# RECALLKEEP_USE_DOCKER="0"            # 0 = never use Docker, 1 = always use the compose service

# ─── LLM provider (embeddings + summaries) ──────────────────────
# RECALLKEEP_LLM_PROVIDER picks where embeddings and summaries are computed:
#   openai (default) OpenAI cloud. Set OPENAI_API_KEY.
#   gemini           Google Gemini through its OpenAI-compatible endpoint. Set GEMINI_API_KEY.
#   local            Any OpenAI-compatible local server (Ollama, LM Studio). No key needed.
#                    Defaults: http://localhost:11434/v1, nomic-embed-text, llama3.2.
#   none             No external calls. No embeddings or summaries. Recall uses
#                    full-text search and project tags. Nothing leaves the machine.
# RECALLKEEP_LLM_PROVIDER="none"

# OPENAI_API_KEY="sk-..."       # provider=openai
# GEMINI_API_KEY="..."          # provider=gemini
# OPENAI_BASE_URL="http://localhost:11434/v1"   # custom endpoint for local or gemini
# RECALLKEEP_LLM_BASE_URL="http://localhost:11434/v1"  # same as above, provider=local only
# RECALLKEEP_LLM_MODEL="gpt-4.1-nano"                  # chat model for summaries and learning
# RECALLKEEP_EMBED_MODEL="text-embedding-3-small"      # embedding model
# RECALLKEEP_EMBED_DIMS="1536"         # must match the vector(1536) schema; only change on a fresh DB
# RECALLKEEP_EMBED="off"               # turn embeddings off but keep summaries

# ─── HTTP API server ────────────────────────────────────────────
# RECALLKEEP_API_PORT="7775"
# RECALLKEEP_API_HOST="127.0.0.1"   # anything other than loopback requires RECALLKEEP_API_TOKEN
# RECALLKEEP_API_TOKEN="..."           # when set, clients send `Authorization: Bearer <token>`
# RECALLKEEP_WARMUP_MS="15000"          # cap on the start-up warm-up that primes recall (the first search is otherwise slow)
# RECALLKEEP_CORS_ORIGINS=""           # comma-separated browser origins allowed to call the API (default none)
# RECALLKEEP_URL="http://127.0.0.1:7775"  # where the MCP server, hooks and pi extension find the API
# RECALLKEEP_CLIENT_TIMEOUT_MS="2000"  # MCP server and hook request timeout
# RECALLKEEP_CWD="..."                 # MCP server: project directory, if the client starts it elsewhere
# RECALLKEEP_HOOK_DEBUG="1"            # hooks print errors to stderr instead of failing silently

# ─── Storage paths ──────────────────────────────────────────────
# RECALLKEEP_DATA_DIR="~/.recallkeep"  # local state (entity and key-value sidecar db)
# RECALLKEEP_SIDECAR_DB="..."          # explicit sidecar path; ~/.claude/memory-api-sidecar.db is kept if it exists
# RECALLKEEP_BACKUP_DIR="./backups"    # where `backup` writes dumps
# RECALLKEEP_DB_CONTAINER="..."        # container for backup/restore; default is this repo's compose service
# RECALLKEEP_PG_DUMP="pg_dump"         # without Docker: pg_dump path for backup, if not on PATH
# RECALLKEEP_PSQL="psql"               # without Docker: psql path for restore, if not on PATH

# ─── pi session capture ─────────────────────────────────────────
# /session/sync only reads files under pi's sessions dir. Follows pi's own
# PI_CODING_AGENT_SESSION_DIR and PI_CODING_AGENT_DIR. Override here if needed.
# RECALLKEEP_PI_SESSIONS_DIR="~/.pi/agent/sessions"
# RECALLKEEP_PI_MESSAGE_CAP="50000"    # max chars stored per message
# RECALLKEEP_PI_TOOLRESULT_CAP="2000"  # max chars stored per tool result

# ─── Recall tuning (defaults are tested; change with care) ──────
# RECALLKEEP_SEMANTIC_RECALL="1"       # 0 = full-text only
# RECALLKEEP_SEMANTIC_FLOOR="0.33"     # min cosine similarity for semantic matches in message (history) recall; short rows need 0.35
# RECALLKEEP_FTS_CEILING="0.55"
# RECALLKEEP_W_RELEVANCE="0.6"
# RECALLKEEP_W_RECENCY="0.15"
# RECALLKEEP_W_TIER="0.15"
# RECALLKEEP_W_CONFIDENCE="0.1"
# RECALLKEEP_CHUNK_CHARS="6000"        # embedding chunk size
# RECALLKEEP_CHUNK_OVERLAP="400"
# RECALLKEEP_AUTO_LEARN="true"         # "false" stops learning extraction on store
# RECALLKEEP_DECISIONS_CONVO_CAP="60000"

# ─── Tooling ────────────────────────────────────────────────────
# RECALLKEEP_BUN_PATH="/opt/bun/bin/bun"   # absolute bun path for hooks if bun is not on PATH
# RECALLKEEP_PROJECT_DIR / RECALLKEEP_LOG_DIR     # scripts/cron-maintain.sh overrides
# RECALLKEEP_SERVICE_NAME="dev.recallkeep" # launchd label or systemd unit `bun run update` restarts
# RECALLKEEP_TEST_DATABASE_URL="postgresql://.../recallkeep_test"  # enables DB tests in `bun test`
